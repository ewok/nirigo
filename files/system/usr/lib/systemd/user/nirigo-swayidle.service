[Unit]
# Lock the session before the machine suspends.
#
# wayblue installs swaylock and swayidle for the niri image but wires up
# neither (its sway and hyprland images ship a config; niri got nothing), so
# without this unit the Legion Go suspends straight to an unlocked session.
#
# swayidle's `-w` is the whole point: it takes a logind *delay* inhibitor and
# blocks until `swaylock -f` reports the screen locked before releasing it.
# Without `-w` the suspend races the locker and you can resume unlocked.
#
# The delay is capped by InhibitDelayMaxSec in logind.conf, which defaults to
# 5s -- see /etc/systemd/logind.conf.d/inhibit-delay.conf.
#
# swaylock authenticates through /etc/pam.d/swaylock, which this image
# configures for YubiKey (pam_u2f) with a password fallback.
#
# Ordering: upstream's niri.service declares `BindsTo=graphical-session.target`
# and `Before=graphical-session.target`, so starting niri activates the target
# and anything in its .wants is started once the compositor is already up (and
# WAYLAND_DISPLAY is in the session environment). Requisite= makes this unit
# fail fast rather than linger if it is ever started outside a session.
Description=Lock the session before suspend (nirigo)
Documentation=man:swayidle(1)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/swayidle -w before-sleep '/usr/bin/swaylock -f'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
