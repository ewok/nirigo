#!/usr/bin/env bash

# Use the public SteamOS Manager session API. The daemon validates the hardware
# range and writes the Legion Go firmware attributes on our behalf.
set -Eeuo pipefail

service=com.steampowered.SteamOSManager1
path=/com/steampowered/SteamOSManager1
interface=com.steampowered.SteamOSManager1.TdpLimit1

usage() {
    printf 'Usage: %s [rotate|set WATTS|range]\n' "${0##*/}" >&2
    exit 2
}

property() {
    local type value extra
    read -r type value extra < <(busctl --user get-property "$service" "$path" "$interface" "$1")
    [[ $type == u && $value =~ ^[0-9]+$ && -z $extra ]] || return 1
    printf '%s\n' "$value"
}

current=$(property TdpLimit) || {
    printf 'SteamOS Manager TDP is unavailable. Verify steamos-manager.service and the Legion Go firmware attributes.\n' >&2
    exit 1
}

case "${1:-}" in
    '') printf '%s\n' "$current" ;;
    range)
        [[ $# == 1 ]] || usage
        min=$(property TdpLimitMin)
        max=$(property TdpLimitMax)
        printf '%s %s\n' "$min" "$max"
        ;;
    set)
        [[ $# == 2 && $2 =~ ^[0-9]+$ ]] || usage
        min=$(property TdpLimitMin)
        max=$(property TdpLimitMax)
        ((10#$2 >= min && 10#$2 <= max)) || {
            printf 'TDP must be between %s and %s W.\n' "$min" "$max" >&2
            exit 1
        }
        busctl --user set-property "$service" "$path" "$interface" TdpLimit u "$2"
        property TdpLimit
        ;;
    rotate)
        [[ $# == 1 ]] || usage
        min=$(property TdpLimitMin)
        max=$(property TdpLimitMax)
        ((current < max)) && next=$((current + 1)) || next=$min
        busctl --user set-property "$service" "$path" "$interface" TdpLimit u "$next"
        property TdpLimit
        ;;
    *) usage ;;
esac
