#!/usr/bin/env bash

# Use the public SteamOS Manager session API. The daemon validates the hardware
# range and writes the Legion Go firmware attributes on our behalf.
set -Eeuo pipefail

service=com.steampowered.SteamOSManager1
path=/com/steampowered/SteamOSManager1
tdp_interface=com.steampowered.SteamOSManager1.TdpLimit1
profile_interface=com.steampowered.SteamOSManager1.PerformanceProfile1

usage() {
    printf 'Usage: %s [profile [NAME]|rotate|set WATTS|range]\n' "${0##*/}" >&2
    exit 2
}

property() {
    local type value extra
    read -r type value extra < <(busctl --user get-property "$service" "$path" "$tdp_interface" "$1")
    [[ $type == u && $value =~ ^[0-9]+$ && -z $extra ]] || return 1
    printf '%s\n' "$value"
}

profile() {
    local type value extra
    read -r type value extra < <(busctl --user get-property "$service" "$path" "$profile_interface" PerformanceProfile)
    [[ $type == s && $value =~ ^"(low-power|balanced|performance|custom)"$ && -z $extra ]] || return 1
    printf '%s\n' "${value#\"}" | tr -d '"'
}

set_profile() {
    [[ $1 =~ ^(low-power|balanced|performance|custom)$ ]] || {
        printf 'Unknown SteamOS Manager performance profile: %s\n' "$1" >&2
        exit 2
    }
    busctl --user set-property "$service" "$path" "$profile_interface" PerformanceProfile s "$1"
    profile
}

if [[ ${1:-} == profile ]]; then
    if [[ $# == 1 ]]; then
        profile
    elif [[ $# == 2 ]]; then
        set_profile "$2"
    else
        usage
    fi
    exit
fi

# The Legion Go enables TdpLimit1 only while its custom performance profile is
# active. The shortcut selects it before applying a manual watt limit.
if [[ ${1:-} == rotate ]]; then
    set_profile custom >/dev/null
fi

current=$(property TdpLimit) || {
    printf 'SteamOS Manager TDP is unavailable. Select the custom performance profile and verify steamos-manager.service.\n' >&2
    exit 1
}

case "${1:-}" in
    '') printf '%s\n' "$current" ;;
    range)
        [[ $# == 1 ]] || usage
        min=$(property TdpLimitMin)
        max=$(property TdpLimitMax)
        printf '%s %s\n' "$min" "$max"
        ;;
    set)
        [[ $# == 2 && $2 =~ ^[0-9]+$ ]] || usage
        min=$(property TdpLimitMin)
        max=$(property TdpLimitMax)
        ((10#$2 >= min && 10#$2 <= max)) || {
            printf 'TDP must be between %s and %s W.\n' "$min" "$max" >&2
            exit 1
        }
        busctl --user set-property "$service" "$path" "$tdp_interface" TdpLimit u "$2"
        property TdpLimit
        ;;
    rotate)
        [[ $# == 1 ]] || usage
        min=$(property TdpLimitMin)
        max=$(property TdpLimitMax)
        ((current < max)) && next=$((current + 1)) || next=$min
        busctl --user set-property "$service" "$path" "$tdp_interface" TdpLimit u "$next"
        property TdpLimit
        ;;
    *) usage ;;
esac
