#!/usr/bin/env bash
# Run Flatpak Steam (Big Picture) inside gamescope, so every game Steam starts
# is composited by gamescope without per-game launch options.
#
#   nirigo-gamescope-steam --direct   Big Picture as a plain niri window (desktop launcher)
#   nirigo-gamescope-steam            nested gamescope in the niri desktop
#   nirigo-gamescope-steam --session  gamescope drives the display (Game Mode)
#
# Per-user overrides: ~/.config/nirigo/gamescope.conf (bash, sourced).
# `ujust gamescope-config` creates a commented template.
set -uo pipefail

APP=com.valvesoftware.Steam

mode=nested
case "${1:-}" in
    '') ;;
    --session) mode=session ;;
    --direct) mode=direct ;;
    *)
        echo "usage: ${0##*/} [--direct|--session]" >&2
        exit 2
        ;;
esac

# Defaults: native Legion Go panel (2560x1600 @ 144 Hz).
# Steam integration (-e) is only enabled in Game Mode: when nested in niri it
# lets Steam drive window focus and mouse/keyboard clicks land on the wrong
# window (gamepad still works). Game Mode keeps it for the Quick Access menu,
# Performance panel and overlay.
#
# Nested, Steam also needs the SteamOS client flags: with only -gamepadui the
# Big Picture UI goes black after the startup animation (CEF reports 0x0
# browser dimensions). Combined with -e those flags stop Steam from starting,
# so they are nested-only.
#
# Touch does not work nested: gamescope's Wayland backend ignores wl_touch.
#
# Direct mode (the desktop launcher) skips gamescope. Nested, Steam's Guide
# menus (Quick Access, Legion+Y) left Big Picture without gamepad focus while
# touch, mouse and keyboard kept working. As a normal niri window, focus
# follows niri. The Deck flags are not needed there.
NIRIGO_GAMESCOPE_ARGS=(-W 2560 -H 1600 -r 144)
NIRIGO_GAMESCOPE_NESTED_ARGS=(-f)
NIRIGO_GAMESCOPE_SESSION_ARGS=(-e --adaptive-sync)
NIRIGO_STEAM_ARGS=(-gamepadui)
NIRIGO_STEAM_NESTED_ARGS=(-steamos3 -steampal -steamdeck)
NIRIGO_STEAM_SESSION_ARGS=()
NIRIGO_STEAM_DIRECT_ARGS=(-gamepadui)
NIRIGO_STEAM_SHUTDOWN_TIMEOUT=20

conf="${XDG_CONFIG_HOME:-$HOME/.config}/nirigo/gamescope.conf"
if [[ -r $conf ]]; then
    # shellcheck source=/dev/null
    source "$conf"
fi

fail() {
    echo "${0##*/}: $1" >&2
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "Steam (Gamescope)" "Steam (Gamescope)" "$1" 2>/dev/null || true
    fi
    exit 1
}

# Flatpak can retain stale rows in `flatpak ps`; only a live PID is a running
# app. Treating a stale row as running makes `-shutdown` start a fresh Steam
# client that later closes the Steam launched inside gamescope.
steam_running() {
    local app pid
    while read -r app pid; do
        [[ $app == "$APP" && $pid =~ ^[0-9]+$ ]] || continue
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    done < <(flatpak ps --columns=application,pid 2>/dev/null)
    return 1
}

if [[ $mode != direct ]]; then
    command -v gamescope >/dev/null 2>&1 || fail "gamescope is not installed."
fi

# Prefer a user install when Steam exists in both scopes.
if flatpak info --user "$APP" >/dev/null 2>&1; then
    scope=--user
elif flatpak info --system "$APP" >/dev/null 2>&1; then
    scope=--system
else
    fail "Steam is not installed. Run: flatpak install flathub $APP"
fi

# A running desktop Steam just switches to Big Picture, so no restart needed.
if [[ $mode == direct ]]; then
    exec flatpak run "$scope" "$APP" "${NIRIGO_STEAM_DIRECT_ARGS[@]}"
fi

# Keep Steam shutdown and gamescope startup as one transaction. A second
# launcher would otherwise race the first and can place Steam outside gamescope.
command -v flock >/dev/null 2>&1 || fail "flock is not installed."
command -v setsid >/dev/null 2>&1 || fail "setsid is not installed."
lock_file="${XDG_RUNTIME_DIR:-/tmp}/nirigo-steam-${UID}.lock"
exec {lock_fd}>"$lock_file"
flock -n "$lock_fd" || fail "Steam (Gamescope) is already starting or running."

# A running Steam would receive the launch request and open its window outside
# gamescope, so stop it first.
if steam_running; then
    flatpak run "$scope" "$APP" -shutdown >/dev/null 2>&1 || true
    waited=0
    while steam_running; do
        if ((waited >= NIRIGO_STEAM_SHUTDOWN_TIMEOUT)); then
            fail "Steam is still running. Exit Steam and try again."
        fi
        sleep 1
        waited=$((waited + 1))
    done
fi

args=("${NIRIGO_GAMESCOPE_ARGS[@]}")
steam_args=("${NIRIGO_STEAM_ARGS[@]}")
if [[ $mode == session ]]; then
    args+=("${NIRIGO_GAMESCOPE_SESSION_ARGS[@]}")
    steam_args+=("${NIRIGO_STEAM_SESSION_ARGS[@]}")
else
    args+=("${NIRIGO_GAMESCOPE_NESTED_ARGS[@]}")
    steam_args+=("${NIRIGO_STEAM_NESTED_ARGS[@]}")
fi

# Give gamescope and the Flatpak it starts their own process group. This lets
# Game Mode termination reap only this launch, never an independently restarted
# desktop Steam instance.
gamescope_pid=
terminate_gamescope() {
    if [[ -n $gamescope_pid ]] && kill -0 "$gamescope_pid" 2>/dev/null; then
        kill -- "-$gamescope_pid" 2>/dev/null || true
        wait "$gamescope_pid" 2>/dev/null || true
    fi
}
trap terminate_gamescope EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

setsid gamescope "${args[@]}" -- flatpak run "$scope" "$APP" "${steam_args[@]}" &
gamescope_pid=$!
wait "$gamescope_pid"
gamescope_status=$?
gamescope_pid=
trap - EXIT HUP INT TERM

if ((gamescope_status != 0)); then
    echo "${0##*/}: gamescope exited with status $gamescope_status." >&2
fi
exit "$gamescope_status"
